{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Scraper Agent",
  "identifier": "com.autoscraper.agent",
  "version": "0.8.4",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "license": "MIT",
    "licenseFile": "EULA.txt",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "resources": ["resources/chromium-headless-shell-*/**/*"],
    "externalBin": [
      "binaries/scraper-node",
      "binaries/chromium-headless-shell"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements/macos.plist"
    }
  }
}
